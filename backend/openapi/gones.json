  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "tokenType"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "tokenType": {
            "type": "string"
          }
        }
      },
      "EmailAccountRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "rateLimitAccount": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EmailChangeRequest": {
        "required": [
          "newEmail",
          "currentPassword"
        ],
        "type": "object",
        "properties": {
          "newEmail": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "currentPassword": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "rateLimitAccount": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GenericAccountActionResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "HealthStatusResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Instant": {},
      "LoginRequest": {
        "required": [
          "email",
          "password",
          "deviceLabel"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "deviceLabel": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "rateLimitAccount": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PatchUserProfileRequest": {
        "required": [
          "username",
          "firstName",
          "lastName",
          "location",
          "birthYear",
          "preferredLanguage",
          "isFirstNamePublic",
          "isLastNamePublic",
          "isLocationPublic",
          "isBirthYearPublic",
          "isPreferredLanguagePublic",
          "currentPassword"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "location": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "birthYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "preferredLanguage": {
            "pattern": "^(fr|en)$",
            "type": "string"
          },
          "isFirstNamePublic": {
            "type": "boolean"
          },
          "isLastNamePublic": {
            "type": "boolean"
          },
          "isLocationPublic": {
            "type": "boolean"
          },
          "isBirthYearPublic": {
            "type": "boolean"
          },
          "isPreferredLanguagePublic": {
            "type": "boolean"
          },
          "currentPassword": {
            "maxLength": 128,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshSessionResponse": {
        "required": [
          "id",
          "deviceLabel",
          "createdAt",
          "lastUsedAt",
          "idleExpiresAt",
          "absoluteExpiresAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deviceLabel": {
            "type": "string"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "lastUsedAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "idleExpiresAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "absoluteExpiresAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "username",
          "password",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "rateLimitAccount": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "TokenRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "UserEmailHistoryResponse": {
        "required": [
          "id",
          "email",
          "recordedAt",
          "retainUntil",
          "redactedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "recordedAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "retainUntil": {
            "$ref": "#/components/schemas/Instant"
          },
          "redactedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Instant"
              }
            ]
          }
        }
      },
      "UserProfileResponse": {
        "required": [
          "id",
          "email",
          "emailVerified",
          "globalRole",
          "username",
          "firstName",
          "lastName",
          "location",
          "birthYear",
          "preferredLanguage",
          "isFirstNamePublic",
          "isLastNamePublic",
          "isLocationPublic",
          "isBirthYearPublic",
          "isPreferredLanguagePublic",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "globalRole": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "birthYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "isFirstNamePublic": {
            "type": "boolean"
          },
          "isLastNamePublic": {
            "type": "boolean"
          },
          "isLocationPublic": {
            "type": "boolean"
          },
          "isBirthYearPublic": {
            "type": "boolean"
          },
          "isPreferredLanguagePublic": {
            "type": "boolean"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      }
    }
