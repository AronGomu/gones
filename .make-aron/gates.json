{
  "version": 1,
  "stack": "node-ts+dotnet",
  "detected_from": ["package.json", "vitest.config.ts", "backend/Gones.sln", "backend/Directory.Packages.props"],
  "cmd": {
    "typecheck": "bash .make-aron/cmd/typecheck.sh {base}",
    "lint": "bash .make-aron/cmd/lint.sh {base}",
    "build": "bash .make-aron/cmd/build.sh {base}",
    "test": "bash .make-aron/cmd/test.sh {base}",
    "test_one": "bash .make-aron/cmd/test-one.sh {file}",
    "coverage": "bash .make-aron/cmd/coverage.sh {base}",
    "complexity": "bash .make-aron/cmd/complexity.sh",
    "mutation": "bash .make-aron/cmd/mutation.sh {base}"
  },
  "paths": {
    "src": "src",
    "lcov": "coverage/lcov.info",
    "mutation_json": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "crap": 6,
    "crap_risk": 4,
    "coverage": 1.0,
    "mutation": 1.0,
    "max_file_lines": 400,
    "max_equivalents_per_ticket": 3
  },
  "determinism": {
    "TZ": "UTC",
    "env": { "SEED": "0", "PYTHONHASHSEED": "0", "DOTNET_CLI_TELEMETRY_OPTOUT": "1" }
  },
  "qa": {
    "cmd": "bash .make-aron/cmd/qa.sh",
    "required": true
  }
}
