{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["json", "clear-text", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation-js.json" },
  "mutate": ["src/**/*.ts", "ops/**/*.ts", "!src/**/*.test.ts", "!ops/**/*.test.ts"],
  "concurrency": 4,
  "coverageAnalysis": "perTest",
  "tempDirName": ".make-aron/.stryker-tmp",
  "cleanTempDir": true
}
