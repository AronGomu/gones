{
  "name": "gones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "build": "ng build",
    "build:pages": "ng build --base-href /gones/ && node scripts/prepare-github-pages.mjs",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "backend:build": "dotnet build backend/Gones.sln --configuration Release",
    "backend:test": "dotnet test backend/Gones.sln --configuration Release"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "angular-eslint": "21.4.0",
    "cypress": "^15.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "qs": "6.15.2"
  }
}