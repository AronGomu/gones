# Gones currently runs frontend-only with browser localStorage persistence.
# No required environment variables are needed for local development or Cloudflare Pages.

# Future ASP.NET bridge placeholder. Leave empty until API cutover.
API_BASE_URL=

# Optional vendor-neutral OpenTelemetry export. Empty keeps OTLP disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
GONES_OTEL_CONSOLE_EXPORTER=false

# Local C08 auth smoke only. Keep auth disabled unless exercising hidden API.
GONES_FEATURES__AUTH_V1=false
GONES_AUTH_PROVIDER=Local
# Set a unique 32+ character value before enabling auth outside local smoke.
GONES_AUTH_SIGNING_KEY=
