# Public Angular build-time Supabase settings.
# Angular environment files read these values manually today; copy values into src/environments/*.ts
# or wire your Cloudflare Pages build step to replace them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase CLI local Google OAuth placeholders.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
