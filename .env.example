# Frontend data authority. Declared, never inferred (ADR 0020): `server` is the only mode, and it
# requires the exact API origin. An incoherent pair fails the image build and then refuses to start
# the app rather than running with no data source.
GONES_FRONTEND_DATA_MODE=server
GONES_FRONTEND_API_BASE_URL=http://127.0.0.1:5080
GONES_FRONTEND_AUTH_V1=true
GONES_FRONTEND_ADMIN_V1=true

# C44 runtime injection. The four build arguments above are only the artifact's DEFAULTS: the same
# image can be served on any origin because these are read at container start, validated by
# deploy/nginx/gones-data-authority.sh, and written to /runtime-config.json plus the CSP connect-src.
# Leave them unset to serve the declaration the image was built with.
GONES_DATA_MODE=server
GONES_API_BASE_URL=https://localhost:8443
GONES_AUTH_V1=true
GONES_ADMIN_V1=true

# Optional vendor-neutral OpenTelemetry export. Empty keeps OTLP disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
GONES_OTEL_CONSOLE_EXPORTER=false

# API-side capability flags. They gate server features; they never decide where data lives.
GONES_FEATURES__CALENDAR_V1=false

# ADR 0040 player statistics read model. On start the API rebuilds `player_statistics` when the stored
# formula version is not the one the build computes with, before it serves traffic. Set false only if
# that rebuild costs more than the container start budget allows: the one-shot `migrator` service
# already runs before the API and can carry the same work, and the code path is identical.
GONES_PLAYER_STATISTICS__REBUILD_ON_STARTUP=true

# Local auth smoke only. Keep auth disabled unless exercising hidden API.
GONES_FEATURES__AUTH_V1=false
GONES_AUTH_PROVIDER=Local
# Set a unique 32+ character value before enabling auth outside local smoke.
GONES_AUTH_SIGNING_KEY=
# HTTPS origin embedded in auth lifecycle emails.
GONES_PUBLIC_APP_ORIGIN=https://localhost:4200
# Refresh-cookie topology — what makes a signed-in session survive a browser reload. Defaults below
# describe a frontend served from the same site as the API. A frontend on a DIFFERENT registrable
# domain needs SAMESITE=None, SECURE=true and HTTPS on both origins; browsers drop `None` without
# `Secure`, so `None` forces the flag on regardless of what SECURE says. Plain-HTTP hosts other than
# localhost/127.0.0.1 must set SECURE=false or the cookie is never stored.
GONES__AUTH__REFRESHCOOKIE__SAMESITE=Lax
GONES__AUTH__REFRESHCOOKIE__SECURE=true
# C11 OAuth: Fake allowed only in Development/Testing. External requires exact HTTPS callback origin,
# both client IDs, plus each secret from direct env or mounted-file path (never both).
GONES_OAUTH_CALLBACK_ORIGIN=
GONES_GOOGLE_CLIENT_ID=
GONES_GOOGLE_CLIENT_SECRET=
GONES_GOOGLE_CLIENT_SECRET_FILE=
GONES_FACEBOOK_CLIENT_ID=
GONES_FACEBOOK_CLIENT_SECRET=
GONES_FACEBOOK_CLIENT_SECRET_FILE=
# Local file sink only: opt in when manually exercising one-time action links.
GONES_EMAIL_SINK_INCLUDE_ACTION_LINKS=false

# C28 Brevo delivery. Compose/G-FULL/G-RUN stay on File fake; never commit real values.
# Set GONES_EMAIL_TRANSPORT=Brevo only in deployed Worker config.
GONES_BREVO_API_BASE_URL=https://api.brevo.com/v3/
GONES_BREVO_API_KEY=
GONES_BREVO_API_KEY_FILE=
GONES_BREVO_SENDER_EMAIL=
GONES_BREVO_SENDER_NAME=Gones Calendar
GONES_BREVO_MAX_CONCURRENCY=4
GONES_BREVO_TIMEOUT_SECONDS=25
GONES_BREVO_IDEMPOTENCY_WINDOW_HOURS=24
# Configure same rotated random 32+ base64url path token in API + Brevo webhook URL.
GONES_BREVO_WEBHOOK_PATH_TOKEN=
GONES_BREVO_WEBHOOK_PATH_TOKEN_FILE=
GONES_BREVO_WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# C41 platform-agnostic runtime contract. Every key below is honoured by a plain Linux container
# host; none of them names a cloud vendor. See docs/RUNTIME_CONTRACT.md.
# Database DSN: supply exactly one of the two forms. The _FILE form is preferred on hosts that can
# mount a secret, because it keeps the credential out of the process environment.
GONES_DB_CONNECTION=
GONES_DB_CONNECTION_FILE=
GONES_AUTH_SIGNING_KEY_FILE=
# Exact origins allowed to call the API. Wildcards are rejected at startup.
GONES_ALLOWED_ORIGINS=
# Trusted TLS reverse proxies, as IP addresses and/or CIDR networks. Empty means X-Forwarded-* is
# ignored entirely and every anonymous caller shares one rate-limit partition.
GONES_FORWARDED_PROXIES=
GONES_FORWARDED_PROXY_HOP_LIMIT=1
# Drain window after SIGTERM. Keep it below the orchestrator's kill grace period.
GONES_SHUTDOWN_TIMEOUT_SECONDS=25
# Worker lease: one replica holds work for this long before another may reclaim it.
GONES_NOTIFICATION_LEASE_SECONDS=120
# Self-hosted or fake identity provider endpoints. HTTPS only; empty keeps the real provider URLs.
GONES_OAUTH_GOOGLE_AUTHORIZATION_ENDPOINT=
GONES_OAUTH_GOOGLE_TOKEN_ENDPOINT=
GONES_OAUTH_GOOGLE_USERINFO_ENDPOINT=
GONES_OAUTH_FACEBOOK_AUTHORIZATION_ENDPOINT=
GONES_OAUTH_FACEBOOK_TOKEN_ENDPOINT=
GONES_OAUTH_FACEBOOK_USERINFO_ENDPOINT=
# Backup/restore image. GONES_BACKUP_ROOT must be a mounted directory; nothing is written elsewhere.
GONES_BACKUP_ROOT=/backups
GONES_BACKUP_DSN=
GONES_BACKUP_DSN_FILE=
GONES_BACKUP_KEY_FILE=
