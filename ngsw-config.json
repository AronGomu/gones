{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**"] }
    }
  ],
  "dataGroups": [
    {
      "name": "public-event-reads",
      "version": 1,
      "urls": [
        "/api/events$",
        "/api/events?**",
        "/api/events/*$",
        "/api/organizations$",
        "/api/organizations?**",
        "/api/organizations/*$"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "public-archive-reads",
      "version": 2,
      "urls": [
        "/api/archive/leagues/all$",
        "/api/archive/league-seasons/all$",
        "/api/archive/tournaments/all$",
        "/api/archive/tournaments/all?**",
        "/api/archive/years$",
        "/api/archive/league-seasons/*/tournaments$",
        "/api/archive/league-seasons/*/result$",
        "/api/archive/tournaments/*$",
        "/api/archive/tournaments/*/result$",
        "/api/archive/global-player-statistics$",
        "/api/archive/global-player-statistics?**",
        "/api/archive/global-player-statistics/all$",
        "/api/archive/global-player-statistics/all?**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "public-catalog-reads",
      "version": 1,
      "urls": ["/api/formats$", "/api/deck-archetypes$"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
