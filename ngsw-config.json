{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**"] }
    }
  ],
  "dataGroups": [
    {
      "name": "public-calendar-reads",
      "version": 1,
      "urls": [
        "/api/events$",
        "/api/events?**",
        "/api/events/*$",
        "/api/organizations$",
        "/api/organizations?**",
        "/api/organizations/*$"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "public-league-archive-reads",
      "version": 1,
      "urls": [
        "/api/leagues-archive$",
        "/api/leagues-archive?**",
        "/api/leagues-archive/*$",
        "/api/leagues-archive/*/result$",
        "/api/leagues-archive/*/tournaments-archive/*$",
        "/api/leagues-archive/*/tournaments-archive/*/result$",
        "/api/leagues-archive/*/players/*/statistics$"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "public-catalog-reads",
      "version": 1,
      "urls": ["/api/formats$", "/api/deck-archetypes$"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
