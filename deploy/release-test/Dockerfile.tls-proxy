# Local stand-in for the TLS reverse proxy the host is required to provide (C41).
#
# It is deliberately generic nginx with a generic configuration: the point of the rehearsal is that
# the application only needs *some* proxy that terminates TLS and states X-Forwarded-For/-Proto.
FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6

USER root
RUN rm -rf /etc/nginx/templates /etc/nginx/conf.d/default.conf
COPY deploy/release-test/tls-proxy.conf /etc/nginx/conf.d/tls-proxy.conf
USER 101:101
EXPOSE 8443
STOPSIGNAL SIGQUIT
