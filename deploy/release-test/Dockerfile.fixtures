# Local test fixtures for the C41 release rehearsal. Never shipped, never published.
#
# One image, three roles: generate the test CA/certs/secrets, serve the fake OIDC provider and the
# fake Brevo API over TLS, and probe that the application network has no egress.
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43

RUN apk add --no-cache openssl
COPY deploy/release-test/bootstrap.sh deploy/release-test/egress-probe.sh /usr/local/bin/
COPY deploy/release-test/fake-provider.mjs /opt/fixtures/fake-provider.mjs
RUN chmod 0555 /usr/local/bin/bootstrap.sh /usr/local/bin/egress-probe.sh
WORKDIR /opt/fixtures
