# HOST-OWNED server block, never mounted by the app project.
# Substitute ONLY GONES_PROD_HOST, derived from the validated HTTPS origin.
# See docs/SHARED_HOST.md for mandatory http/default-server logging/TLS policy.
server {
  listen 443 ssl;
  server_name ${GONES_PROD_HOST};
  ssl_certificate /etc/gones/edge/tls/prod/fullchain.pem;
  ssl_certificate_key /etc/gones/edge/tls/prod/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  # Request paths/queries can contain webhook, OAuth, reset or invitation tokens.
  # Override inherited access/error logs. Host must also suppress pre-server errors.
  access_log off;
  error_log /dev/null crit;
  # Never recompress API responses excluded by the app's BREACH protection.
  gzip off;
  client_max_body_size 1048576;
  client_body_timeout 30s;
  proxy_connect_timeout 5s;
  proxy_read_timeout 30s;
  proxy_send_timeout 30s;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header Forwarded "";

  location = /api/event-images {
    client_max_body_size 5308416;
    proxy_pass http://172.30.20.10:8080;
  }
  location /api/ {
    proxy_pass http://172.30.20.10:8080;
  }
  location = /health/live {
    proxy_pass http://172.30.20.10:8080;
  }
  # Deep readiness is operator-only: it touches DB/object storage.
  location /health/ { return 404; }
  location / {
    proxy_pass http://172.30.20.20:8080;
  }
}
